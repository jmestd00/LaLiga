# EditorConfig ayuda a mantener estilos de código coherentes entre diferentes IDEs y editores.
# http://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{xml,yml,yaml,json,properties}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
indent_size = 2

[*.{sh,cmd,bash}]
end_of_line = lf

[Makefile]
indent_style = tab
